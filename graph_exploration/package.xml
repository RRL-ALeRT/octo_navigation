<?xml version="1.0"?>
<package format="3">
  <name>graph_exploration</name>
  <version>0.1.0</version>
  <description>Frontier-based exploration toward a goal using the ALeRT navigation graph</description>
  <maintainer email="maximillian.kirsch@alumni.fh-aachen.de">max</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>mbf_msgs</depend>
  <depend>alert_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>octomap_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
